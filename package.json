  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/register": "^7.21.0",
    "chai": "^4.3.7",
    "chai-dom": "^1.11.0",
    "jsdom": "^22.0.0",
    "mocha": "^10.0.0",
    "nyc": "^15.1.0"
  },
  "dependencies": {
    "util.promisify": "^1.1.3"
  }
}